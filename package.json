{
  "name": "google-meet-recorder-root",
  "version": "1.0.0",
  "description": "Root runner for Google Meet Recording Bot & Web Dashboard",
  "scripts": {
    "start": "npm --prefix \"Record Bot\" run dashboard",
    "dashboard": "npm --prefix \"Record Bot\" run dashboard",
    "build": "npm --prefix \"Record Bot\" run build",
    "build:tray": "cmd /c scripts\\build_tray.bat",
    "desktop:shortcut": "cmd /c ADD_TO_DESKTOP.bat",
    "bot": "npm --prefix \"Record Bot\" run start:bot",
    "package": "powershell -ExecutionPolicy Bypass -File scripts\\package.ps1",
    "startup:enable": "cmd /c ENABLE_WINDOWS_STARTUP.bat",
    "startup:disable": "cmd /c DISABLE_WINDOWS_STARTUP.bat"
  }
}
